# ConnectingPC — document root (public/)
# Compatibile con Apache + PHP FastCGI (Aruba/Plesk): nessuna direttiva php_value qui.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS obbligatorio in produzione: decommentare quando il certificato è attivo.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Segnale per la verifica dei requisiti (EnvironmentCheck): le regole sono applicate.
    RewriteRule ^ - [E=CPC_REWRITE:1]

    # Tutto ciò che non è un file esistente passa dal front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# File nascosti e sensibili mai serviti
<FilesMatch "(^\.|\.(sql|log|ini|env|bak|lock|md|dist|sh)$)">
    Require all denied
</FilesMatch>

# Le risposte dinamiche ricevono gli header di sicurezza da PHP (App\Security\SecurityHeaders);
# qui si coprono i file statici. "setifempty" evita duplicati sulle risposte di PHP.
<IfModule mod_headers.c>
    Header setifempty X-Content-Type-Options "nosniff"
    Header setifempty X-Frame-Options "DENY"
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header setifempty Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; frame-ancestors 'none'"
    Header unset X-Powered-By
</IfModule>
