# ConnectingPC — document root (public/)
# Compatibile con Apache + PHP FastCGI (Aruba/Plesk): nessuna direttiva php_value qui.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS obbligatorio in produzione: decommentare quando il certificato è attivo.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Segnale per la verifica dei requisiti (EnvironmentCheck): le regole sono applicate.
    RewriteRule ^ - [E=CPC_REWRITE:1]

    # Tutto ciò che non è un file esistente passa dal front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# File nascosti e sensibili mai serviti
<FilesMatch "(^\.|\.(sql|log|ini|env|bak|lock|md|dist|sh)$)">
    Require all denied
</FilesMatch>

# Le risposte dinamiche ricevono gli header di sicurezza da PHP (App\Security\SecurityHeaders);
# qui si coprono SOLO i file statici, scelti per estensione: le richieste riscritte verso index.php
# non corrispondono, quindi niente header duplicati. ("setifempty" non basta: LiteSpeed lo tratta come "set"
# e due Content-Security-Policy sulla stessa pagina bloccano gli script, P-013.)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|json|svg|png|jpe?g|gif|webp|ico|woff2?|ttf|txt|xml|map)$">
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "DENY"
        Header set Referrer-Policy "strict-origin-when-cross-origin"
        Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; frame-ancestors 'none'"
    </FilesMatch>
    Header unset X-Powered-By
</IfModule>
