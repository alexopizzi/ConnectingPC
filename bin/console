#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Console di ConnectingPC: `php bin/console help` per l'elenco dei comandi.
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

/** @var App\Core\Container $container */
$container = require dirname(__DIR__) . '/app/bootstrap.php';

$console = new App\Console\Application($container);
(require APP_BASE_PATH . '/app/Console/commands.php')($console);

exit($console->run($argv));
