{
    "name": "alexopizzi/connectingpc",
    "description": "ConnectingPC — piattaforma territoriale dei servizi per la popolazione straniera (Piacenza)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.33"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
