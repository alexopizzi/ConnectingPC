# ConnectingPC — modello di configurazione.
# Copiare in .env e personalizzare. Il file .env NON va mai versionato.
# Documentazione di ogni variabile: vault "34 - Configurazione".

# --- Applicazione ---
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8090
# Generare con: php bin/console key:generate (valore diverso per ogni ambiente)
APP_KEY=
APP_TIMEZONE=Europe/Rome
APP_DEFAULT_LOCALE=it

# --- Database (in Docker DB_HOST e DB_PORT sono impostati da docker-compose) ---
DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=connectingpc
DB_USER=connectingpc
DB_PASS=connectingpc_dev
# Solo per Docker locale
DB_ROOT_PASS=connectingpc_root_dev
# Facoltativo: utente con privilegi DDL per le migrazioni
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# --- Email (in Docker MAIL_HOST/MAIL_PORT puntano a Mailpit) ---
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=noreply@connectingpc.local
MAIL_FROM_NAME=ConnectingPC

# --- Sessioni e sicurezza ---
SESSION_NAME=cpc_sid
SESSION_IDLE_MINUTES=60
SESSION_ADMIN_IDLE_MINUTES=30
# CIDR separati da virgola; vuoto = nessuna restrizione
ADMIN_IP_ALLOWLIST=
# Token per /health?detail=1 e per la pagina di manutenzione (valori casuali lunghi in produzione)
HEALTH_TOKEN=
MAINTENANCE_TOKEN=
TRUSTED_PROXIES=

# --- Mappa e geocodifica ---
# Proxy con cache sul nostro dominio (consigliato, D-005/Q-06); in alternativa l'URL diretto delle tile OSM
MAP_TILE_URL=/tiles/{z}/{x}/{y}.png
MAP_TILE_UPSTREAM=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"
MAP_DEFAULT_CENTER=45.0526,9.6930
MAP_DEFAULT_ZOOM=10
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT="ConnectingPC/0.1 (+https://example.invalid)"
GEOCODER_EMAIL=

# --- Log ---
LOG_LEVEL=debug

# --- Porte Docker locali (solo sviluppo) ---
APP_PORT=8090
DB_FORWARD_PORT=3310
PMA_PORT=8091
MAILPIT_PORT=8025
